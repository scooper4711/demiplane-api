{
  "name": "@scooper4711/demiplane-api",
  "version": "#VERSION#",
  "description": "TypeScript client for the Demiplane Nexus character API — auth, GraphQL queries, and engine read/write",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "demiplane",
    "nexus",
    "pathfinder",
    "character-sheet",
    "graphql",
    "api-client"
  ],
  "author": "scooper4711",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scooper4711/demiplane-api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
